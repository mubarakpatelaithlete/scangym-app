# ═══════════════════════════════════════════════════════════════
# ScanGym — Channel Integration Environment Variables
# ═══════════════════════════════════════════════════════════════
# Add these to Railway → Settings → Variables → Raw Editor

# ─── SLACK ────────────────────────────────────────────────────
# App: https://api.slack.com/apps/<YOUR_APP_ID>
# Webhook URL: https://scangym.com/api/channels/slack/webhook
#              (or /api/chatbot/slack/events — both work)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CLIENT_ID=your-slack-client-id
SLACK_APP_ID=your-slack-app-id

# ─── MICROSOFT TEAMS ─────────────────────────────────────────
# Bot: Azure Portal → ScanGymBot
# Webhook URL: https://scangym.com/api/channels/msteams/webhook
#              (or /api/chatbot/msteams/messages — both work)
TEAMS_APP_ID=your-azure-bot-app-id
TEAMS_APP_TENANT_ID=your-azure-tenant-id
TEAMS_BOT_TYPE=MultiTenant
# IMPORTANT: Create a client secret in Azure Entra ID for the Managed Identity,
# then set it here. Without this, the bot can receive but NOT reply to messages.
# Steps: Azure Portal → Entra ID → App Registrations → Find your app →
#        Certificates & secrets → New client secret → Copy VALUE here
TEAMS_APP_PASSWORD=your-teams-app-client-secret

# ─── TWILIO (WhatsApp + SMS) ─────────────────────────────────
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════
# BUTTON CATALOG — what each remaining button on /everything waits for
# ═══════════════════════════════════════════════════════════════
# Every button in server/lib/buttons-catalog.js turns itself on the moment its
# requirement below is satisfied. No code change, no deploy. Store/profile links
# are not env vars — fill their URL into LISTINGS in that same file once the
# listing is public.

# ─── AI TOOLS INSIDE SCANGYM ─────────────────────────────────
ELEVENLABS_API_KEY=
SUNO_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=

# ─── SIGN IN ─────────────────────────────────────────────────
# SAML/OIDC metadata URL for company SSO
SSO_METADATA_URL=

# ─── ADVERTISE (partner self-serve ad buying) ────────────────
ADS_GOOGLE_CUSTOMER_ID=
ADS_META_ACCOUNT_ID=
ADS_BING_ACCOUNT_ID=
ADS_TIKTOK_ACCOUNT_ID=
ADS_X_ACCOUNT_ID=
ADS_SPOTIFY_ACCOUNT_ID=
ADS_REDDIT_ACCOUNT_ID=
ADS_LINKEDIN_ACCOUNT_ID=
ADS_CHATGPT_ACCOUNT_ID=
