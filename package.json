{
  "name": "scangym-app",
  "version": "3.2.0",
  "description": "ScanGym - Book a Gym. Anywhere. Full-stack gym finder & booking marketplace.",
  "private": true,
  "scripts": {
    "start": "cd server && node server.js",
    "dev": "cd server && node server.js",
    "test": "node --test tests/*.test.js",
    "brand:audit": "node tools/brand-audit.js",
    "android:sync": "npx cap sync android",
    "android:build": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  }
}