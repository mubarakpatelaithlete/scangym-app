{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mubarakpatelaithlete/scangym",
  "title": "ScanGym — Book Any Gym",
  "description": "Search, compare prices, and book gym day passes. No memberships, just flexible pay-per-session gym access through ScanGym.",
  "repository": {
    "url": "https://github.com/mubarakpatelaithlete/scangym-app",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@scangym/mcp-server",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ScanGym API base URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SCANGYM_API_URL"
        }
      ]
    }
  ]
}
